package com.example.util

import android.content.Context
import android.content.Intent
import android.os.Bundle
import android.os.Handler
import android.os.Looper
import android.speech.RecognitionListener
import android.speech.RecognizerIntent
import android.speech.SpeechRecognizer
import android.speech.tts.TextToSpeech
import android.speech.tts.UtteranceProgressListener
import android.util.Log
import androidx.compose.runtime.Immutable
import com.example.data.VoiceDialect
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.coroutines.flow.asStateFlow
import java.util.Locale

private const val TAG = "VoiceSpeechController"

enum class VoicePersona(
    val displayName: String,
    val subtitle: String,
    val pitch: Float,
    val speechRate: Float,
    val preferMale: Boolean
) {
    DIYA(
        displayName = "Diya",
        subtitle = "Warm & Friendly",
        pitch = 1.06f,
        speechRate = 0.98f,
        preferMale = false
    ),
    AARAV(
        displayName = "Aarav",
        subtitle = "Crisp & Calm",
        pitch = 0.88f,
        speechRate = 0.96f,
        preferMale = true
    ),
    RIYA(
        displayName = "Riya",
        subtitle = "Fast Counter Mode",
        pitch = 1.12f,
        speechRate = 1.18f,
        preferMale = false
    ),
    KABIR(
        displayName = "Kabir",
        subtitle = "Deep & Clear",
        pitch = 0.78f,
        speechRate = 0.92f,
        preferMale = true
    )
}

@Immutable
data class SpeechState(
    val listening: Boolean = false,
    val partialText: String = "",
    val rmsDb: Float = 0f,
    val errorMessage: String? = null,
    val soundboxEnabled: Boolean = true,
    val speaking: Boolean = false,
    val activePersona: VoicePersona = VoicePersona.DIYA,
    val wakeWordEnabled: Boolean = false,
    val wakeWordStandby: Boolean = false,
    val wakeWordTriggeredAt: Long = 0L
)

class VoiceSpeechController(private val appContext: Context) {

    private val _state = MutableStateFlow(SpeechState())
    val state: StateFlow<SpeechState> = _state.asStateFlow()

    private var speechRecognizer: SpeechRecognizer? = null
    private var wakeRecognizer: SpeechRecognizer? = null
    private var textToSpeech: TextToSpeech? = null
    private var ttsReady = false
    private var onFinalTranscriptCallback: ((String) -> Unit)? = null
    private val mainHandler = Handler(Looper.getMainLooper())

    @Volatile
    private var pendingUtteranceId: String? = null
    @Volatile
    private var onSpeechCompleteCallback: (() -> Unit)? = null
    private var lastAppliedDialect: VoiceDialect? = null
    private var lastAppliedPersona: VoicePersona? = null

    // "Hey Vyapar" hands-free wake-word state
    private var isAppInForeground: Boolean = true
    private var wakeDialect: VoiceDialect = VoiceDialect.HINDI
    private var onWakeCommandCallback: ((String) -> Unit)? = null
    private var onWakeOnlyCallback: (() -> Unit)? = null
    private var wakeRestartRunnable: Runnable? = null
    private var wakePartialFireRunnable: Runnable? = null
    private var wakeWordAlreadyHandledInSession: Boolean = false

    private val wakeRegex = Regex(
        pattern = "(?i)(?:\\b(?:hey|he|hi|hello|ok|okay|namaste|namaskar|vanakkam)\\s+(?:vyapar\\s*flow|vyaparflow|vyapar|vyapaar|viapar|byapar|biapar|wyapar|vapor|vaper|vyaper|vyaapar|bypaar)\\b|हे\\s*(?:व्यापार|व्यापर)|ओके\\s*(?:व्यापार|व्यापर)|हाय\\s*(?:व्यापार|व्यापर))"
    )

    init {
        initTts()
    }

    private fun initTts() {
        try {
            textToSpeech = TextToSpeech(appContext) { status ->
                if (status == TextToSpeech.SUCCESS) {
                    ttsReady = true
                    textToSpeech?.setOnUtteranceProgressListener(object : UtteranceProgressListener() {
                        override fun onStart(utteranceId: String?) {
                            _state.value = _state.value.copy(speaking = true)
                            mainHandler.post { pauseWakeStandbyInternal() }
                        }

                        override fun onDone(utteranceId: String?) {
                            _state.value = _state.value.copy(speaking = false)
                            if (utteranceId != null && utteranceId == pendingUtteranceId) {
                                val cb = onSpeechCompleteCallback
                                pendingUtteranceId = null
                                onSpeechCompleteCallback = null
                                if (cb != null) {
                                    mainHandler.postDelayed({ cb() }, 120L)
                                    return
                                }
                            }
                            scheduleWakeStandbyIfEligible(delayMs = 380L)
                        }

                        @Deprecated("Deprecated in Java")
                        override fun onError(utteranceId: String?) {
                            _state.value = _state.value.copy(speaking = false)
                            pendingUtteranceId = null
                            onSpeechCompleteCallback = null
                            scheduleWakeStandbyIfEligible(delayMs = 450L)
                        }

                        override fun onError(utteranceId: String?, errorCode: Int) {
                            _state.value = _state.value.copy(speaking = false)
                            pendingUtteranceId = null
                            onSpeechCompleteCallback = null
                            scheduleWakeStandbyIfEligible(delayMs = 450L)
                        }
                    })
                    applyVoiceSettings(VoiceDialect.HINDI, _state.value.activePersona)
                } else {
                    Log.w(TAG, "TTS initialization failed with status=$status")
                }
            }
        } catch (e: Exception) {
            Log.e(TAG, "Failed to create TextToSpeech", e)
        }
    }

    private fun applyVoiceSettings(dialect: VoiceDialect, persona: VoicePersona) {
        val tts = textToSpeech ?: return
        if (lastAppliedDialect == dialect && lastAppliedPersona == persona) {
            return
        }
        val locale = Locale.forLanguageTag(dialect.localeTag)
        val result = tts.setLanguage(locale)
        val effectiveLocale = if (result == TextToSpeech.LANG_MISSING_DATA || result == TextToSpeech.LANG_NOT_SUPPORTED) {
            val fallback = Locale.forLanguageTag("en-IN")
            tts.setLanguage(fallback)
            fallback
        } else {
            locale
        }

        // Attempt to select an on-device voice matching the requested language & persona tone
        try {
            val voices = tts.voices.orEmpty()
            val localeVoices = voices.filter { v ->
                v.locale?.language.equals(effectiveLocale.language, ignoreCase = true) && !v.isNetworkConnectionRequired
            }.ifEmpty {
                voices.filter { v -> v.locale?.language.equals(effectiveLocale.language, ignoreCase = true) }
            }

            if (localeVoices.isNotEmpty()) {
                val genderTokens = if (persona.preferMale) {
                    listOf("male", "-m-", "cfd", "inm", "hid", "hie", "end", "ene")
                } else {
                    listOf("female", "-f-", "hia", "hib", "hic", "ena", "enb", "enc")
                }
                val matched = localeVoices.firstOrNull { v ->
                    val nameLower = v.name.lowercase(Locale.US)
                    genderTokens.any { token -> nameLower.contains(token) }
                } ?: localeVoices.getOrNull(persona.ordinal % localeVoices.size)

                if (matched != null) {
                    tts.voice = matched
                }
            }
        } catch (e: Exception) {
            Log.w(TAG, "Voice lookup fallback to pitch/rate", e)
        }

        tts.setPitch(persona.pitch)
        tts.setSpeechRate(persona.speechRate)
        lastAppliedDialect = dialect
        lastAppliedPersona = persona
    }

    fun selectPersona(persona: VoicePersona) {
        _state.value = _state.value.copy(activePersona = persona)
    }

    fun previewPersona(persona: VoicePersona, dialect: VoiceDialect) {
        _state.value = _state.value.copy(activePersona = persona, soundboxEnabled = true)
        val sampleLine = when (dialect) {
            VoiceDialect.MARATHI -> "Namaskar! Mi ${persona.displayName}, tumchi VyaparFlow Soundbox madatnis. 1,450 rupaye UPI payment aale aahe."
            VoiceDialect.TAMIL -> "Vanakkam! Naan ${persona.displayName}, ungal VyaparFlow Soundbox. 1,450 roobai UPI payment vandhulladhu."
            VoiceDialect.ENGLISH_IN -> "Hello! I am ${persona.displayName}, your VyaparFlow Soundbox assistant. Received 1,450 rupees via UPI."
            VoiceDialect.HINDI -> "Namaste! Main hoon ${persona.displayName}, aapki VyaparFlow Soundbox. 1,450 rupaye UPI payment prapt hua."
        }
        speak(sampleLine, dialect, forceSpeak = true)
    }

    fun toggleSoundbox(enabled: Boolean) {
        _state.value = _state.value.copy(soundboxEnabled = enabled)
        if (!enabled) {
            stopSpeaking()
        }
    }

    fun stopSpeaking() {
        pendingUtteranceId = null
        onSpeechCompleteCallback = null
        try {
            textToSpeech?.stop()
        } catch (_: Exception) {
        } finally {
            _state.value = _state.value.copy(speaking = false)
            scheduleWakeStandbyIfEligible(delayMs = 350L)
        }
    }

    fun speak(
        text: String,
        dialect: VoiceDialect,
        forceSpeak: Boolean = false,
        onComplete: (() -> Unit)? = null
    ) {
        if ((!_state.value.soundboxEnabled && !forceSpeak) || text.isBlank() || !ttsReady) {
            if (onComplete != null) {
                mainHandler.postDelayed({ onComplete() }, 200L)
            } else {
                scheduleWakeStandbyIfEligible(delayMs = 350L)
            }
            return
        }
        try {
            pauseWakeStandbyInternal()
            applyVoiceSettings(dialect, _state.value.activePersona)
            val utteranceId = "vf_tts_${System.currentTimeMillis()}"
            pendingUtteranceId = if (onComplete != null) utteranceId else null
            onSpeechCompleteCallback = onComplete
            val speakResult = textToSpeech?.speak(text, TextToSpeech.QUEUE_FLUSH, null, utteranceId)
            if (speakResult == TextToSpeech.ERROR) {
                pendingUtteranceId = null
                onSpeechCompleteCallback = null
                _state.value = _state.value.copy(speaking = false)
                scheduleWakeStandbyIfEligible(delayMs = 400L)
            }
        } catch (e: Exception) {
            Log.e(TAG, "TTS speak failed", e)
            pendingUtteranceId = null
            onSpeechCompleteCallback = null
            _state.value = _state.value.copy(speaking = false)
            scheduleWakeStandbyIfEligible(delayMs = 400L)
        }
    }

    // --- "HEY VYAPAR" HANDS-FREE WAKE-WORD ENGINE ---

    fun setWakeWordEnabled(
        enabled: Boolean,
        dialect: VoiceDialect,
        onWakeCommand: (String) -> Unit,
        onWakeOnly: () -> Unit
    ) {
        wakeDialect = dialect
        onWakeCommandCallback = onWakeCommand
        onWakeOnlyCallback = onWakeOnly

        if (!enabled) {
            _state.value = _state.value.copy(wakeWordEnabled = false, wakeWordStandby = false)
            pauseWakeStandbyInternal()
            return
        }

        if (!SpeechRecognizer.isRecognitionAvailable(appContext)) {
            _state.value = _state.value.copy(
                wakeWordEnabled = false,
                wakeWordStandby = false,
                errorMessage = "Speech recognition is unavailable on this device for 'Hey Vyapar'."
            )
            return
        }

        _state.value = _state.value.copy(wakeWordEnabled = true, errorMessage = null)
        scheduleWakeStandbyIfEligible(delayMs = 150L)
    }

    fun updateWakeWordDialect(dialect: VoiceDialect) {
        if (wakeDialect == dialect) return
        wakeDialect = dialect
        if (_state.value.wakeWordEnabled && _state.value.wakeWordStandby) {
            pauseWakeStandbyInternal()
            scheduleWakeStandbyIfEligible(delayMs = 200L)
        }
    }

    fun setAppForeground(inForeground: Boolean) {
        isAppInForeground = inForeground
        if (!inForeground) {
            pauseWakeStandbyInternal()
        } else if (_state.value.wakeWordEnabled) {
            scheduleWakeStandbyIfEligible(delayMs = 350L)
        }
    }

    private fun scheduleWakeStandbyIfEligible(delayMs: Long) {
        wakeRestartRunnable?.let { mainHandler.removeCallbacks(it) }
        wakeRestartRunnable = null
        if (!_state.value.wakeWordEnabled || !isAppInForeground || _state.value.listening || _state.value.speaking) {
            return
        }
        val r = Runnable {
            if (_state.value.wakeWordEnabled && isAppInForeground && !_state.value.listening && !_state.value.speaking) {
                startWakeStandbyInternal()
            }
        }
        wakeRestartRunnable = r
        mainHandler.postDelayed(r, delayMs)
    }

    private fun pauseWakeStandbyInternal() {
        wakeRestartRunnable?.let { mainHandler.removeCallbacks(it) }
        wakeRestartRunnable = null
        wakePartialFireRunnable?.let { mainHandler.removeCallbacks(it) }
        wakePartialFireRunnable = null
        try {
            wakeRecognizer?.stopListening()
            wakeRecognizer?.cancel()
            wakeRecognizer?.destroy()
        } catch (_: Exception) {
        } finally {
            wakeRecognizer = null
            if (_state.value.wakeWordStandby) {
                _state.value = _state.value.copy(wakeWordStandby = false)
            }
        }
    }

    private fun startWakeStandbyInternal() {
        pauseWakeStandbyInternal()
        if (!_state.value.wakeWordEnabled || !isAppInForeground || _state.value.listening || _state.value.speaking) {
            return
        }
        if (!SpeechRecognizer.isRecognitionAvailable(appContext)) return

        wakeWordAlreadyHandledInSession = false
        try {
            val recognizer = SpeechRecognizer.createSpeechRecognizer(appContext)
            wakeRecognizer = recognizer
            recognizer.setRecognitionListener(object : RecognitionListener {
                override fun onReadyForSpeech(params: Bundle?) {
                    _state.value = _state.value.copy(wakeWordStandby = true)
                }

                override fun onBeginningOfSpeech() = Unit
                override fun onRmsChanged(rmsdB: Float) = Unit
                override fun onBufferReceived(buffer: ByteArray?) = Unit
                override fun onEndOfSpeech() = Unit

                override fun onPartialResults(partialResults: Bundle?) {
                    if (wakeWordAlreadyHandledInSession) return
                    val partial = partialResults?.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION)
                        ?.firstOrNull()
                        ?.trim()
                        .orEmpty()
                    if (partial.isBlank()) return

                    val match = extractWakeMatch(partial) ?: return
                    // If user spoke "Hey Vyapar" alone, wait 600ms in case they're continuing a command;
                    // if no more words arrive, fire wake-only fast!
                    wakePartialFireRunnable?.let { mainHandler.removeCallbacks(it) }
                    if (match.trailingCommand.isBlank()) {
                        val fire = Runnable {
                            if (!wakeWordAlreadyHandledInSession) {
                                handleWakeTrigger(trailingCommand = "")
                            }
                        }
                        wakePartialFireRunnable = fire
                        mainHandler.postDelayed(fire, 650L)
                    }
                }

                override fun onResults(results: Bundle?) {
                    wakePartialFireRunnable?.let { mainHandler.removeCallbacks(it) }
                    wakePartialFireRunnable = null
                    if (wakeWordAlreadyHandledInSession) return

                    val candidates = results?.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION).orEmpty()
                    val matched = candidates.firstNotNullOfOrNull { extractWakeMatch(it) }
                    if (matched != null) {
                        handleWakeTrigger(trailingCommand = matched.trailingCommand)
                    } else {
                        scheduleWakeStandbyIfEligible(delayMs = 380L)
                    }
                }

                override fun onError(error: Int) {
                    wakePartialFireRunnable?.let { mainHandler.removeCallbacks(it) }
                    wakePartialFireRunnable = null
                    if (wakeWordAlreadyHandledInSession) return

                    when (error) {
                        SpeechRecognizer.ERROR_INSUFFICIENT_PERMISSIONS -> {
                            _state.value = _state.value.copy(
                                wakeWordEnabled = false,
                                wakeWordStandby = false,
                                errorMessage = "Microphone permission is required for 'Hey Vyapar'."
                            )
                        }
                        SpeechRecognizer.ERROR_RECOGNIZER_BUSY,
                        SpeechRecognizer.ERROR_AUDIO,
                        SpeechRecognizer.ERROR_NETWORK,
                        SpeechRecognizer.ERROR_NETWORK_TIMEOUT -> {
                            scheduleWakeStandbyIfEligible(delayMs = 1200L)
                        }
                        else -> {
                            // Normal silence timeout / no speech heard -> quietly re-arm standby!
                            scheduleWakeStandbyIfEligible(delayMs = 420L)
                        }
                    }
                }

                override fun onEvent(eventType: Int, params: Bundle?) = Unit
            })

            val intent = Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH).apply {
                putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM)
                putExtra(RecognizerIntent.EXTRA_LANGUAGE, wakeDialect.localeTag)
                putExtra(RecognizerIntent.EXTRA_PARTIAL_RESULTS, true)
                putExtra(RecognizerIntent.EXTRA_MAX_RESULTS, 3)
                putExtra(RecognizerIntent.EXTRA_SPEECH_INPUT_COMPLETE_SILENCE_LENGTH_MILLIS, 900L)
                putExtra(RecognizerIntent.EXTRA_SPEECH_INPUT_POSSIBLY_COMPLETE_SILENCE_LENGTH_MILLIS, 700L)
            }
            _state.value = _state.value.copy(wakeWordStandby = true)
            recognizer.startListening(intent)
        } catch (e: Exception) {
            Log.w(TAG, "Hey Vyapar standby recognizer restart failed: ${e.message}")
            _state.value = _state.value.copy(wakeWordStandby = false)
            scheduleWakeStandbyIfEligible(delayMs = 1400L)
        }
    }

    private data class WakeMatch(val trailingCommand: String)

    private fun extractWakeMatch(text: String): WakeMatch? {
        val m = wakeRegex.find(text.trim()) ?: return null
        val trailing = text.trim()
            .substring(m.range.last + 1)
            .trimStart(',', '.', ':', '-', ' ')
            .trim()
        return WakeMatch(trailingCommand = trailing)
    }

    private fun handleWakeTrigger(trailingCommand: String) {
        wakeWordAlreadyHandledInSession = true
        pauseWakeStandbyInternal()
        _state.value = _state.value.copy(
            wakeWordStandby = false,
            wakeWordTriggeredAt = System.currentTimeMillis(),
            partialText = if (trailingCommand.isNotBlank()) "Hey Vyapar • $trailingCommand" else "Hey Vyapar!"
        )
        if (trailingCommand.isNotBlank()) {
            onWakeCommandCallback?.invoke(trailingCommand)
            scheduleWakeStandbyIfEligible(delayMs = 900L)
        } else {
            onWakeOnlyCallback?.invoke()
        }
    }

    // --- ACTIVE FULL COMMAND VOICE CAPTURE ---

    fun startListening(dialect: VoiceDialect, onFinalTranscript: (String) -> Unit) {
        if (!SpeechRecognizer.isRecognitionAvailable(appContext)) {
            _state.value = _state.value.copy(
                listening = false,
                errorMessage = "On-device speech recognition is unavailable here. Use the text bar or quick voice chips below."
            )
            return
        }

        pauseWakeStandbyInternal()
        stopListening(resumeWake = false)
        textToSpeech?.stop()
        onFinalTranscriptCallback = onFinalTranscript

        try {
            val recognizer = SpeechRecognizer.createSpeechRecognizer(appContext)
            speechRecognizer = recognizer
            recognizer.setRecognitionListener(object : RecognitionListener {
                override fun onReadyForSpeech(params: Bundle?) {
                    _state.value = _state.value.copy(listening = true, partialText = "", errorMessage = null)
                }

                override fun onBeginningOfSpeech() {
                    _state.value = _state.value.copy(listening = true)
                }

                override fun onRmsChanged(rmsdB: Float) {
                    _state.value = _state.value.copy(rmsDb = rmsdB.coerceIn(0f, 12f))
                }

                override fun onBufferReceived(buffer: ByteArray?) = Unit

                override fun onEndOfSpeech() {
                    _state.value = _state.value.copy(listening = false, rmsDb = 0f)
                }

                override fun onError(error: Int) {
                    val message = when (error) {
                        SpeechRecognizer.ERROR_AUDIO -> "Audio recording issue. Please retry."
                        SpeechRecognizer.ERROR_NO_MATCH -> "Could not catch that clearly. Please speak again or type below."
                        SpeechRecognizer.ERROR_SPEECH_TIMEOUT -> "No speech heard. Tap the mic or say 'Hey Vyapar'."
                        SpeechRecognizer.ERROR_INSUFFICIENT_PERMISSIONS -> "Microphone permission is required."
                        else -> "Voice capture unavailable right now. You can type or tap a quick command."
                    }
                    _state.value = _state.value.copy(listening = false, rmsDb = 0f, errorMessage = message)
                    scheduleWakeStandbyIfEligible(delayMs = 600L)
                }

                override fun onResults(results: Bundle?) {
                    val spoken = results?.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION)
                        ?.firstOrNull()
                        ?.trim()
                        .orEmpty()
                    _state.value = _state.value.copy(listening = false, partialText = spoken, rmsDb = 0f)
                    if (spoken.isNotBlank()) {
                        onFinalTranscriptCallback?.invoke(spoken)
                    } else {
                        scheduleWakeStandbyIfEligible(delayMs = 500L)
                    }
                }

                override fun onPartialResults(partialResults: Bundle?) {
                    val partial = partialResults?.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION)
                        ?.firstOrNull()
                        .orEmpty()
                    if (partial.isNotBlank()) {
                        _state.value = _state.value.copy(partialText = partial)
                    }
                }

                override fun onEvent(eventType: Int, params: Bundle?) = Unit
            })

            val intent = Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH).apply {
                putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM)
                putExtra(RecognizerIntent.EXTRA_LANGUAGE, dialect.localeTag)
                putExtra(RecognizerIntent.EXTRA_PARTIAL_RESULTS, true)
                putExtra(RecognizerIntent.EXTRA_MAX_RESULTS, 1)
                putExtra(RecognizerIntent.EXTRA_SPEECH_INPUT_COMPLETE_SILENCE_LENGTH_MILLIS, 850L)
                putExtra(RecognizerIntent.EXTRA_SPEECH_INPUT_POSSIBLY_COMPLETE_SILENCE_LENGTH_MILLIS, 650L)
            }
            _state.value = _state.value.copy(listening = true, partialText = "", errorMessage = null)
            recognizer.startListening(intent)
        } catch (e: Exception) {
            Log.e(TAG, "Failed to start SpeechRecognizer", e)
            _state.value = _state.value.copy(
                listening = false,
                errorMessage = "Could not start microphone: ${e.localizedMessage ?: "unknown error"}"
            )
            scheduleWakeStandbyIfEligible(delayMs = 600L)
        }
    }

    fun stopListening(resumeWake: Boolean = true) {
        try {
            speechRecognizer?.stopListening()
            speechRecognizer?.destroy()
        } catch (_: Exception) {
        } finally {
            speechRecognizer = null
            _state.value = _state.value.copy(listening = false, rmsDb = 0f)
            if (resumeWake) {
                scheduleWakeStandbyIfEligible(delayMs = 450L)
            }
        }
    }

    fun clearError() {
        _state.value = _state.value.copy(errorMessage = null)
    }

    fun release() {
        pauseWakeStandbyInternal()
        stopListening(resumeWake = false)
        try {
            textToSpeech?.stop()
            textToSpeech?.shutdown()
        } catch (_: Exception) {
        } finally {
            textToSpeech = null
        }
    }
}